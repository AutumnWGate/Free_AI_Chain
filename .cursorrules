        ./crypto/  # 加密模块  
            ./signature.rs  # 签名和验证相关功能
            ./address.rs  # 地址生成及相关操作
            ./hash.rs  # 哈希计算相关函数，SHA-256
            ./mod.rs  # 模块入口
        ./network/
                TODO: 待设计
        ./wallet/  # 钱包模块 todo
            ./address.rs  # 地址生成和验证，BIP 标准相关逻辑
            ./menmonic.rs  # 助记词生成和管理，BIP39 标准
            ./error.rs  # 错误处理
            ./mod.rs  # 模块入口
